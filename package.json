{
  "name": "@involvex/disgo-cli",
  "version": "1.0.1",
  "description": "A lightweight, secure, and feature-rich Discord terminal client",
  "bin": {
    "disgo-cli": "./bin/cli.js"
  },
  "scripts": {
    "build": "go build -o disgo-cli .",
    "build:task": "task build",
    "start": "disgo-cli",
    "dev": "go run .",
    "dev:task": "task dev",
    "serve": "disgo-cli --serve",
    "clean": "del disgo-cli disgo-cli.exe 2>nul || rm -f disgo-cli",
    "clean:task": "task clean",
    "test": "go test ./...",
    "test:task": "task test",
    "lint": "golangci-lint run --timeout=5m",
    "lint:task": "task lint",
    "format": "go fmt ./... && goimports -w $(find . -name '*.go' -not -path './vendor/*')",
    "format:task": "task format",
    "check": "npm run format && npm run lint && npm run test && npm run build",
    "check:task": "task check",
    "prepublishOnly": "npm run version:prepatch",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "version:prepatch": "npm version prepatch --preid=dev",
    "version:prerelease": "npm version prerelease",
    "preversion": "task check",
    "postversion": "git push && git push --tags",
    "commit": "git add . && git commit -m",
    "commit:all": "git add . && git commit",
    "publish:patch": "npm run version:patch && npm publish",
    "publish:minor": "npm run version:minor && npm publish",
    "publish:major": "npm run version:major && npm publish",
    "release:patch": "task release:patch",
    "release:minor": "task release:minor",
    "release:major": "task release:major"
  },
  "keywords": ["discord", "cli", "terminal", "chat", "client"],
  "author": "involvex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/involvex/disgo-cli.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "os": ["linux", "darwin", "win32"],
  "preferGlobal": true
}
